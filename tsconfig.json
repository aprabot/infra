{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node", "lib": ["ES2022"],
    "outDir": "dist", "rootDir": ".", "strict": true, "noUnusedLocals": true, "noImplicitReturns": true,
    "skipLibCheck": true, "types": ["node"]
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts"]
}
