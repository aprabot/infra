{
  "name": "aprabot-infra",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "package": "python3 scripts/package.py",
    "config": "python3 scripts/live.py config",
    "synth": "cdk synth --quiet",
    "verify": "cdk synth --quiet && python3 scripts/live.py verify",
    "map": "cdk synth --quiet && python3 scripts/live.py map"
  },
  "dependencies": { "aws-cdk-lib": "2.278.0", "constructs": "10.8.1" },
  "devDependencies": { "aws-cdk": "2.1149.0", "typescript": "5.9.3", "@types/node": "22.18.0" }
}
